<launch>
  <arg name="namespace" default="dvs" />
  <arg name="serial_number" default="" />
  <arg name="master" default="true" />

  <group ns="$(arg namespace)">
    <node name="event_camera_driver" pkg="dvxplorer_ros_driver" type="dvxplorer_ros_driver" output="screen">
      <param name="serial_number" type="str" value="$(arg serial_number)" />
      <param name="master" value="$(arg master)" />
    </node>
  </group>
</launch>
