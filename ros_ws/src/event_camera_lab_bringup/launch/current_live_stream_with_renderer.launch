<launch>
  <arg name="aps_enabled" default="false" />
  <arg name="display_method" default="red-blue" />

  <include file="$(find event_camera_lab_bringup)/launch/current_live_stream.launch">
    <arg name="aps_enabled" value="$(arg aps_enabled)" />
  </include>

  <node name="dvs_renderer" pkg="dvs_renderer" type="dvs_renderer" output="screen">
    <param name="display_method" value="$(arg display_method)" />
    <remap from="events" to="/dvs/events" />
    <remap from="image" to="/dvs/image_raw" />
    <remap from="camera_info" to="/dvs/camera_info" />
  </node>

  <node name="image_view" pkg="rqt_image_view" type="rqt_image_view" args="/dvs_rendering">
    <remap from="image" to="/dvs_rendering" />
  </node>

  <node name="rqt_reconfigure" pkg="rqt_reconfigure" type="rqt_reconfigure" />
</launch>
